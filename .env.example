# ---- Supabase (auth for /admin) ----
# From the Supabase dashboard: Project Settings -> API. The anon/publishable key is safe to ship.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Comma-separated emails allowed to edit. Defaults to hglowe1@gmail.com,goldband@gmail.com if unset.
ADMIN_EMAILS=hglowe1@gmail.com,goldband@gmail.com

# ---- Firestore (content storage) ----
# GCP project that holds the Firestore database. Auth uses Application Default Credentials:
#   locally:    gcloud auth application-default login
#   Cloud Run:  the service's runtime service account (needs roles/datastore.user)
GOOGLE_CLOUD_PROJECT=ai-bitz
# FIRESTORE_DATABASE_ID=(default)

# ---- Local development only ----
# Lets you open /admin under `npm run dev` without Supabase. Ignored by production builds.
# LOCAL_ADMIN_EMAIL=goldband@gmail.com
